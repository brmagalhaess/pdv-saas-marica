PDV_DOMAIN=pdv.seudominio.com.br
PDV_VERSION=2.0.0
PDV_SECRET_KEY=GENERATE_UNIQUE_RANDOM_SECRET
POSTGRES_PASSWORD=GENERATE_RANDOM_PASSWORD
PDV_ENCRYPTION_KEY=GENERATE_FERNET_KEY
PDV_PLATFORM_MFA_REQUIRED=1
PDV_LICENSE_PRIVATE_KEY_PATH=/srv/pdv2/secrets/license-private.pem
PDV_LICENSE_PUBLIC_KEY_PATH=/srv/pdv2/secrets/license-public.pem
RESTIC_REPOSITORY=s3:https://seu-endpoint-s3/seu-bucket/pdv2
RESTIC_PASSWORD=GENERATE_RANDOM_BACKUP_PASSWORD
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
PDV_ASAAS_WEBHOOK_TOKEN=
PDV_ALLOW_LIVE_FISCAL=0
PDV_EMAIL_HOST=
PDV_EMAIL_PORT=587
PDV_EMAIL_USER=
PDV_EMAIL_PASSWORD=
PDV_DEFAULT_FROM_EMAIL=
# CIDR da rede interna do proxy Dokploy; use o intervalo real da instalação.
PDV_TRUSTED_PROXY_CIDRS=172.18.0.0/16
