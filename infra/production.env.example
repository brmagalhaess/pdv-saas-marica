PDV_DOMAIN=pdv2.crowntech.com.br
PDV_VERSION=2.0.0
PDV_SECRET_KEY=GENERATE_UNIQUE_RANDOM_SECRET
POSTGRES_PASSWORD=GENERATE_RANDOM_PASSWORD
PDV_ENCRYPTION_KEY=GENERATE_FERNET_KEY
PDV_PLATFORM_MFA_REQUIRED=1
# Django admin em /control/: desligado por padrão. Ligue (1) só para inspeção
# pontual; exige superusuário com MFA verificada (docs/DEPLOY-DOKPLOY.md).
PDV_ENABLE_DJANGO_ADMIN=0
# Nível dos logs de cloud e worker na saída padrão.
PDV_LOG_LEVEL=INFO
PDV_LICENSE_PRIVATE_KEY_PATH=/srv/pdv2/secrets/license-private.pem
PDV_LICENSE_PUBLIC_KEY_PATH=/srv/pdv2/secrets/license-public.pem
# Par Ed25519 próprio para assinar versões do terminal (separado da licença).
# OBRIGATÓRIO e diferente do par de licença: o deploy falha sem estas duas linhas.
# Gere o par (shared.licensing.generate_keypair()) e grave os arquivos na VPS ANTES
# do primeiro deploy com o terminal novo: o terminal fixa a primeira chave de
# versões que recebe e passa a recusar manifestos assinados por outra chave.
PDV_RELEASE_PRIVATE_KEY_PATH=/srv/pdv2/secrets/release-private.pem
PDV_RELEASE_PUBLIC_KEY_PATH=/srv/pdv2/secrets/release-public.pem
RESTIC_REPOSITORY=s3:https://seu-endpoint-s3/seu-bucket/pdv2
RESTIC_PASSWORD=GENERATE_RANDOM_BACKUP_PASSWORD
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Aplica a retenção (7 diários, 4 semanais, 12 mensais) após cada backup.
BACKUP_PRUNE=1
PDV_ASAAS_WEBHOOK_TOKEN=
PDV_ALLOW_LIVE_FISCAL=0
PDV_EMAIL_HOST=
PDV_EMAIL_PORT=587
PDV_EMAIL_USER=
PDV_EMAIL_PASSWORD=
PDV_DEFAULT_FROM_EMAIL=
# CIDR da rede interna do proxy Dokploy; use o intervalo real da instalação.
PDV_TRUSTED_PROXY_CIDRS=172.18.0.0/16
