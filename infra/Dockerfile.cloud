FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app:/app/cloud
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && groupadd -g 10001 app && useradd -u 10001 -g app -m app
COPY cloud ./cloud
COPY shared ./shared
COPY integrations ./integrations
COPY operations ./operations
COPY web ./web
COPY logo-pdv2.svg ./web/assets/logo-pdv2.svg
RUN PDV_DEBUG=1 python cloud/manage.py collectstatic --noinput && mkdir -p /data && chown app:app /data
# Mount point of the pdv2_secrets volume. A new, empty volume copies this
# owner and mode, so secrets-init (user 10001:70) can write without root.
# Group 70 is postgres in postgres:17-alpine (reads db_password).
RUN mkdir -p /secrets && chown 10001:70 /secrets && chmod 0750 /secrets
USER app
WORKDIR /app/cloud
EXPOSE 8080
# Access log without query strings (%(U)s = path only): one-time tokens, such as the accountant
# package link (?t=...), must never be written to the logs.
CMD ["gunicorn", "pdvcloud.wsgi:application", "--bind", "0.0.0.0:8080", "--workers", "3", "--threads", "2", "--timeout", "60", "--access-logfile", "-", "--access-logformat", "%(h)s %(l)s %(u)s %(t)s \"%(m)s %(U)s %(H)s\" %(s)s %(b)s %(L)s", "--error-logfile", "-"]
