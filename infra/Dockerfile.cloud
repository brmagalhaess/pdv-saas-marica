FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app:/app/cloud
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && groupadd -g 10001 app && useradd -u 10001 -g app -m app
COPY cloud ./cloud
COPY shared ./shared
COPY integrations ./integrations
COPY operations ./operations
COPY web ./web
COPY logo-pdv2.svg ./web/assets/logo-pdv2.svg
RUN PDV_DEBUG=1 python cloud/manage.py collectstatic --noinput && mkdir -p /data && chown app:app /data
USER app
WORKDIR /app/cloud
EXPOSE 8080
CMD ["gunicorn", "pdvcloud.wsgi:application", "--bind", "0.0.0.0:8080", "--workers", "3", "--threads", "2", "--timeout", "60", "--access-logfile", "-", "--error-logfile", "-"]
