<?xml version="1.0" encoding="utf-8"?>
<!-- Nada sai do aparelho: nem backup na nuvem nem transferência entre aparelhos.
     O token de sessão (cifrado com chave do Android Keystore) nunca deve ser copiado. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
